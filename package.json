{
  "name": "my-coding-skills",
  "version": "0.4.0",
  "description": "Portable interaction and visual design, development workflow, QA, acceptance, and external-agent adapter skills for Codex, Claude Code, Gemini CLI, OpenCode, and Grok Build.",
  "type": "module",
  "bin": {
    "skills": "./bin/skills.mjs"
  },
  "files": [
    "design",
    "clarify",
    "dev",
    "qa",
    "acceptance",
    "kimi-code",
    "claude-code",
    "codex-cli",
    "opencode",
    "grok-build-cli",
    "scripts/skills-doctor.sh",
    "scripts/check-routing-policy.mjs",
    "scripts/test-install-safety.sh",
    "bin/skills.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "doctor": "bash scripts/skills-doctor.sh",
    "check:cli": "node bin/skills.mjs list",
    "check:policy": "node scripts/check-routing-policy.mjs",
    "eval:routing": "node evals/routing/runner.mjs",
    "eval:behavior": "node evals/behavior/runner.mjs",
    "eval:e2e": "node evals/e2e/smoke.mjs",
    "adapters:sync": "node scripts/sync-adapters.mjs --write",
    "test": "node scripts/sync-adapters.mjs --check && node scripts/check-routing-policy.mjs && bash scripts/test-install-safety.sh"
  },
  "keywords": [
    "codex",
    "claude-code",
    "opencode",
    "grok-build",
    "skills",
    "design",
    "clarify",
    "dev",
    "qa",
    "acceptance"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "yaml": "^2.9.0"
  }
}
